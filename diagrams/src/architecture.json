    {
      "dot": "emerald",
      "title": "Live path",
      "items": [
        "Hooks time every tool call into events",
        "Agents name the friction with friction log or bump",
        "SessionStart hands every new session the hot list"
      ]
    },
    {
      "dot": "violet",
      "title": "Catch-up path",
      "items": [
        "Nightly backfill rebuilds events from transcripts",
        "Only sessions with 2+ unlogged failures reach the model"
      ]
    },
    {
      "dot": "rose",
      "title": "Leaves the machine",
      "items": [
        "Transcript excerpts to claude -p, if backfill runs",
        "Items and hits to Jira, only when sync is enabled",
        "Raw tool events never do"
      ]
