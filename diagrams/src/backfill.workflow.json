  "cards": [
    {
      "dot": "cyan",
      "title": "When it runs",
      "items": [
        "systemd timer or LaunchAgent, 03:30 daily",
        "friction backfill --since 2d",
        "--dry-run stops after stage 1"
      ]
    },
    {
      "dot": "amber",
      "title": "Cost control",
      "items": [
        "Clean sessions never reach the model",
        "At most --limit sessions per run (40)",
        "Whole-cluster chunks: 160 lines, up to 3 per run",
        "Sessions the hooks saw are imported only back to their first hook event"
      ]
    },
    {
      "dot": "rose",
      "title": "On failure",
      "items": [
        "An analyser error leaves the session unprocessed",
        "The next run retries it",
        "Invalid findings are dropped; the mark moves only past analysed clusters",
        "Low-confidence Jev clusters are counted uncertain"
      ]
    }
  ]
