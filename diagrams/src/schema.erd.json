  "cards": [
    {
      "dot": "amber",
      "title": "Declared vs logical keys",
      "items": [
        "Only occurrences.item_id is a declared REFERENCES",
        "Dashed links are joins the code makes, not constraints",
        "items.merged_into points back at items: a merged item follows it to the survivor"
      ]
    },
    {
      "dot": "cyan",
      "title": "Retention",
      "items": [
        "events and sessions are deleted after 30 days",
        "items and occurrences are kept; evidence links go stale"
      ]
    },
    {
      "dot": "violet",
      "title": "Sync columns",
      "items": [
        "remote_key, remote_url, dirty, uid, pushed came in with tracker sync",
        "PRAGMA user_version counts applied migrations"
      ]
    }
  ]
